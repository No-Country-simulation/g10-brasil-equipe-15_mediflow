
# Configurações do MediFlow
# Duplique este arquivo como .env e preencha suas credenciais locais

# LLM Providers (Google Gemini / OpenAI / Claude)
GEMINI_API_KEY=sua_chave_gemini_aqui
OPENAI_API_KEY=sua_chave_openai_aqui
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# Oracle Cloud Infrastructure (OCI) - Camada Always Free
OCI_USER_OCID=ocid1.user.oc1..exemplo
OCI_TENANCY_OCID=ocid1.tenancy.oc1..exemplo
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_KEY_FILE=./oci_api_key.pem
OCI_REGION=sa-saopaulo-1
OCI_BUCKET_NAME=mediflow-documentos
OCI_NAMESPACE=seu_namespace_aqui

# Configurações da Aplicação
ENVIRONMENT=development
LOG_LEVEL=INFO

# Origens permitidas no CORS, separadas por vírgula. Vazio = só a mesma origem.
# Ex. para rodar o front em outra porta sem o proxy do Vite: http://localhost:5173
CORS_ORIGINS=

# Limiar padrão de confiança aplicado pelo agente de triagem.
LIMIAR_CONFIANCA=0.85

# true = fixtures oficiais de fronteira (ex.: Borda_Score_084) usam o score de
# modo_fixture.score_forcado no lugar do calculado. Só para demonstração.
FIXTURE_MODE=false
