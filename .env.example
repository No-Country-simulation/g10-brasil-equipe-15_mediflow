
# Configurações do MediFlow
# Duplique este arquivo como .env e preencha suas credenciais locais

# LLM Providers (Google Gemini / OpenAI / Claude)
GEMINI_API_KEY=sua_chave_gemini_aqui
OPENAI_API_KEY=sua_chave_openai_aqui
ANTHROPIC_API_KEY=sua_chave_anthropic_aqui

# Oracle Cloud Infrastructure (OCI) - Camada Always Free
OCI_USER_OCID=ocid1.user.oc1..exemplo
OCI_TENANCY_OCID=ocid1.tenancy.oc1..exemplo
OCI_FINGERPRINT=xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx:xx
OCI_KEY_FILE=./oci_api_key.pem
OCI_REGION=sa-saopaulo-1
OCI_BUCKET_NAME=mediflow-documentos
OCI_NAMESPACE=seu_namespace_aqui

# Configurações da Aplicação
ENVIRONMENT=development
LOG_LEVEL=INFO
