# Configurações do frontend MediFlow
# Duplique este arquivo como .env para sobrescrever os valores padrão

# URL base da API usada pelo cliente HTTP.
# Vazio = mesma origem (em dev, passa pelo proxy do Vite abaixo).
VITE_API_URL=

# Destino do proxy /api no servidor de desenvolvimento (uvicorn src.api.main:app --port 8000)
VITE_PROXY_TARGET=http://localhost:8000
